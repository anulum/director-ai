# =====================================================================
ckpts/
# Ignore everything under /training/ EXCEPT the whitelisted files
# below. Pattern is ``/training/*`` (not ``/training/``) so the
# directory itself is not excluded — required for ``!`` exceptions
# to take effect on child paths.
/training/*
!/training/__init__.py
!/training/_upload_all.py
!/training/build_judge_dataset.py
!/training/data_pipeline.py
!/training/build_contradiction_dataset.py
!/training/train_contradiction.py
!/training/eval_contradiction_holdout.py
!/training/distil_factcg.py
!/training/distil_v5_cloud.py
!/training/lite_scorer_v2_vertex_runner.py
!/training/train_distillation.py
!/training/Dockerfile.distil
!/training/Dockerfile.benchmarks
!/training/Dockerfile.lite_scorer_v2
!/training/cloudbuild.lite_scorer_v2.yaml
!/training/launch_cloud.sh
!/training/requirements-distil.in
!/training/eval_ragtruth_token.py
!/training/jarvislabs_ragtruth_entrypoint.sh
!/training/jarvislabs_ragtruth_token_run.sh
!/training/ragtruth_annotation_review.py
!/training/ragtruth_context_router_probe.py
!/training/ragtruth_fp_audit.py
!/training/ragtruth_fp_noise_audit.py
!/training/ragtruth_reranker_probe.py
!/training/select_ragtruth_checkpoint.py
!/training/train_ragtruth_token.py
!/training/requirements-distil.txt
