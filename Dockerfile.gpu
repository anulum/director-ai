# Director-AI — GPU Docker image
#
# Build:
#   docker build -f Dockerfile.gpu -t director-ai:gpu .
#
# Run:
#   docker run --gpus all -p 8080:8080 director-ai:gpu
#
# The hash-pinned torch dependencies supply CUDA 13 and cuDNN 9 libraries.
# Use a CUDA-13-supported GPU, an NVIDIA driver >=580, and the NVIDIA
# Container Toolkit; qualify CUDA execution on the target before serving.
# ─────────────────────────────────────────────────────────────────────

# ── Stage 1: Install Python packages ──────────────────────────────────

FROM rust:1.98.1-slim@sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7 AS rust-toolchain

FROM python:3.11-slim@sha256:e41613d42d4891e4930f79523f93f81bbc7632584ec65e36ab055f41a800b41e AS builder

WORKDIR /build

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH="/usr/local/cargo/bin:${PATH}" \
    CARGO_BUILD_JOBS=2

COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential=12.12 ca-certificates=20250419 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml setup.py README.md LICENSE NOTICE.md ./
COPY src/ src/
COPY packages/ packages/
COPY requirements/ requirements/
COPY backfire-kernel/ backfire-kernel/

# Free core wheel + BUSL-1.1 director-ai-pro overlay (server surface) —
# same two-wheel composition as the CPU image since the D1 re-slice.
RUN python -m pip install --no-cache-dir --require-hashes --no-deps --prefix=/install \
        -r requirements/docker-build.txt \
    && python -m pip install --no-cache-dir --require-hashes --no-deps --prefix=/install \
        -r requirements/docker-gpu.txt \
    && PYTHONPATH=/install/lib/python3.11/site-packages PATH="/install/bin:${PATH}" \
        maturin build --locked --release --manifest-path backfire-kernel/crates/backfire-ffi/Cargo.toml --out /tmp/backfire-wheel \
    && PYTHONPATH=/install/lib/python3.11/site-packages \
        python -m installer --prefix=/install /tmp/backfire-wheel/backfire_kernel-*.whl \
    && PYTHONPATH=/install/lib/python3.11/site-packages PATH="/install/bin:${PATH}" \
        python -m build --wheel --no-isolation --outdir /tmp/director-wheel . \
    && PYTHONPATH=/install/lib/python3.11/site-packages \
        python -m installer --prefix=/install /tmp/director-wheel/director_ai-*-py3-none-any.whl \
    && PYTHONPATH=/install/lib/python3.11/site-packages PATH="/install/bin:${PATH}" \
        python -m build --wheel --no-isolation --outdir /tmp/director-wheel-pro packages/director-ai-pro \
    && PYTHONPATH=/install/lib/python3.11/site-packages \
        python -m installer --prefix=/install /tmp/director-wheel-pro/director_ai_pro-*-py3-none-any.whl

# ── Stage 2: Export ONNX model ────────────────────────────────────────

FROM python:3.11-slim@sha256:e41613d42d4891e4930f79523f93f81bbc7632584ec65e36ab055f41a800b41e AS model-builder

COPY --from=builder /install /usr/local
COPY src/ /app/src/

WORKDIR /app

ENV PYTHONPATH=/app/src

# ONNX graph/runtime wheels: build-time only for export. Hash-pinned for
# OpenSSF supply-chain compliance and kept on the current transformers line
# already installed by the runtime dependency lock.
COPY requirements/docker-gpu-export.txt /tmp/docker-gpu-export.txt
RUN pip install --no-cache-dir --no-deps --require-hashes \
        -r /tmp/docker-gpu-export.txt

RUN python -c "\
from director_ai.core.nli import export_onnx; \
export_onnx(output_dir='/models/onnx')"

# ── Stage 3: Runtime ──────────────────────────────────────────────────

FROM python:3.11-slim@sha256:e41613d42d4891e4930f79523f93f81bbc7632584ec65e36ab055f41a800b41e

LABEL maintainer="Miroslav Sotek <protoscience@anulum.li>"
LABEL description="Director-AI GPU — ONNX CUDA hallucination guardrail"
LABEL org.opencontainers.image.source="https://github.com/anulum/director-ai"
LABEL org.opencontainers.image.license="Apache-2.0 AND BUSL-1.1"

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=model-builder /models /app/models
COPY src/ src/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DIRECTOR_LOG_LEVEL=INFO \
    DIRECTOR_SERVER_HOST=0.0.0.0 \
    DIRECTOR_SERVER_PORT=8080 \
    DIRECTOR_USE_NLI=true \
    DIRECTOR_ONNX_PATH=/app/models/onnx

RUN adduser --disabled-password --gecos "" appuser
USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import requests; r=requests.get('http://localhost:8080/v1/health'); r.raise_for_status()" || exit 1

ENTRYPOINT ["python", "-m", "director_ai.cli"]
CMD ["serve", "--port", "8080"]
