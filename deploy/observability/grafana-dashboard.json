{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Reviews / minute",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (instance) (rate(director_ai_reviews_total[1m])) * 60",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "title": "Rejection rate (1m)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (instance) (rate(director_ai_reviews_rejected[1m])) / clamp_min(sum by (instance) (rate(director_ai_reviews_total[1m])), 0.001)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "title": "Review latency p50/p95/p99 (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(director_ai_review_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(director_ai_review_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(director_ai_review_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Coherence score p50/p90/p99",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(director_ai_coherence_score_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.90, rate(director_ai_coherence_score_bucket[5m]))",
          "legendFormat": "p90"
        },
        {
          "expr": "histogram_quantile(0.99, rate(director_ai_coherence_score_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Active requests",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "director_ai_active_requests",
          "legendFormat": "active"
        }
      ]
    },
    {
      "title": "Halts / min",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16},
      "targets": [
        {
          "expr": "sum by (instance) (rate(director_ai_halts_total[1m])) * 60",
          "legendFormat": "halts/min"
        }
      ]
    },
    {
      "title": "Stale KB sources",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum(director_ai_kb_stale_sources)",
          "legendFormat": "stale"
        }
      ]
    },
    {
      "title": "Error rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(director_ai_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(director_ai_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "title": "Retune recommended",
      "type": "stat",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "max(director_ai_retune_recommended)",
          "legendFormat": "retune"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 0.2}
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["director-ai", "guardrail", "llm"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "title": "Director-AI Guardrail Overview",
  "uid": "director-ai-overview"
