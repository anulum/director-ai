{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd packages/vercel-ai && npm ci && npm run build",
  "env": {
    "DIRECTOR_AI_ENDPOINT": "@director_ai_endpoint",
    "DIRECTOR_API_KEY": "@director_api_key"
  },
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
