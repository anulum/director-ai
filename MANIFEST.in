include LICENSE
include README.md
include CHANGELOG.md
include NOTICE.md
recursive-include src *.py *.pyi *.pkl

# The sdist must carry the free-wheel build shim so a wheel built from the
# sdist applies the same paid-module slicing as a repo build.
include packages/tier_build_hooks.py
include packages/paid_tier_manifest.json

# Open-core release: keep the BUSL-1.1 advanced & labs packages out of the PyPI
# sdist too (they remain source-available in the git repository). The wheel
# excludes them via pyproject [tool.setuptools.packages.find].exclude.
# Extended 2026-07-16 per decisions D1/D2 (ladder P3 re-slice).
prune src/director_ai/agentic
prune src/director_ai/compliance
prune src/director_ai/enterprise
prune src/director_ai/experimental
prune src/director_ai/ui
prune src/director_ai/voice
