{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anulum.li/schemas/director-ai/customer-model-factory-release-gate.schema.json",
  "title": "DIRECTOR-AI Customer Model Factory Release Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "ready",
    "promotion_allowed",
    "customer_id",
    "workspace_id",
    "tenant_id",
    "deployment_id",
    "generated_at",
    "enterprise_ready",
    "enterprise_blocking_debt_ids",
    "artifact_hashes",
    "observability_operations_evidence",
    "provenance_lineage_evidence",
    "conformal_routing_evidence",
    "deployment_hardening_evidence",
    "blockers",
    "release_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "ready": {
      "type": "boolean"
    },
    "promotion_allowed": {
      "type": "boolean"
    },
    "customer_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "deployment_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "enterprise_ready": {
      "type": "boolean"
    },
    "enterprise_blocking_debt_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "observability_operations_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "environment",
        "operations_packet_uri",
        "dashboard_evidence_uri",
        "operator_signoff_uri",
        "controls_passed",
        "compliance_exports_available",
        "drift_reviewed",
        "evidence_hash"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "environment": {
          "type": "string",
          "enum": [
            "staging",
            "production"
          ]
        },
        "operations_packet_uri": {
          "type": "string",
          "minLength": 1
        },
        "dashboard_evidence_uri": {
          "type": "string",
          "minLength": 1
        },
        "operator_signoff_uri": {
          "type": "string",
          "minLength": 1
        },
        "controls_passed": {
          "type": "boolean"
        },
        "compliance_exports_available": {
          "type": "boolean"
        },
        "drift_reviewed": {
          "type": "boolean"
        },
        "evidence_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance_lineage_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "environment",
        "feedback_loop_run_uri",
        "signed_lineage_packet_uri",
        "tenant_kb_snapshot_uri",
        "operator_signoff_uri",
        "lineage_matches_deployed_facts",
        "protected_claim_conflicts_resolved",
        "evidence_hash"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "environment": {
          "type": "string",
          "enum": [
            "staging",
            "production"
          ]
        },
        "feedback_loop_run_uri": {
          "type": "string",
          "minLength": 1
        },
        "signed_lineage_packet_uri": {
          "type": "string",
          "minLength": 1
        },
        "tenant_kb_snapshot_uri": {
          "type": "string",
          "minLength": 1
        },
        "operator_signoff_uri": {
          "type": "string",
          "minLength": 1
        },
        "lineage_matches_deployed_facts": {
          "type": "boolean"
        },
        "protected_claim_conflicts_resolved": {
          "type": "boolean"
        },
        "evidence_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "conformal_routing_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "environment",
        "domain_calibration_packet_uri",
        "deployment_routing_packet_uri",
        "escalation_route",
        "operator_signoff_uri",
        "target_coverage",
        "empirical_coverage",
        "calibration_sample_count",
        "escalation_route_verified",
        "reject_to_human_available",
        "evidence_hash"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "environment": {
          "type": "string",
          "enum": [
            "staging",
            "production"
          ]
        },
        "domain_calibration_packet_uri": {
          "type": "string",
          "minLength": 1
        },
        "deployment_routing_packet_uri": {
          "type": "string",
          "minLength": 1
        },
        "escalation_route": {
          "type": "string",
          "minLength": 1
        },
        "operator_signoff_uri": {
          "type": "string",
          "minLength": 1
        },
        "target_coverage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "empirical_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calibration_sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "escalation_route_verified": {
          "type": "boolean"
        },
        "reject_to_human_available": {
          "type": "boolean"
        },
        "evidence_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "deployment_hardening_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "environment",
        "observation_window",
        "telemetry_uri",
        "sustained_load_packet_uri",
        "operator_signoff_uri",
        "async_ordering_passed",
        "tenant_poisoning_passed",
        "evidence_hash"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "environment": {
          "type": "string",
          "enum": [
            "staging",
            "production"
          ]
        },
        "observation_window": {
          "type": "string",
          "minLength": 1
        },
        "telemetry_uri": {
          "type": "string",
          "minLength": 1
        },
        "sustained_load_packet_uri": {
          "type": "string",
          "minLength": 1
        },
        "operator_signoff_uri": {
          "type": "string",
          "minLength": 1
        },
        "async_ordering_passed": {
          "type": "boolean"
        },
        "tenant_poisoning_passed": {
          "type": "boolean"
        },
        "evidence_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "release_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
