{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anulum.li/schemas/director-ai/customer-model-factory-sector-metadata.schema.json",
  "title": "DIRECTOR-AI Customer Model Factory Sector Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "sector_class",
    "knowledge_class",
    "jurisdiction",
    "requires_citation",
    "evidence_refs",
    "requires_escalation"
  ],
  "properties": {
    "sector_class": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_class": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "requires_citation": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires_numeric_evidence": {
      "type": "boolean"
    },
    "numeric_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires_escalation": {
      "type": "boolean"
    },
    "customer_segment": {
      "type": "string"
    },
    "product_family": {
      "type": "string"
    }
  }
}
