{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anulum.li/schemas/director-ai/customer-model-factory-risk-register.schema.json",
  "title": "DIRECTOR-AI Customer Model Factory Risk Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "register_id",
    "ready",
    "customer_id",
    "workspace_id",
    "tenant_id",
    "deployment_id",
    "evidence_hash",
    "monitoring_hash",
    "generated_at",
    "risks",
    "findings",
    "register_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "register_id": {
      "type": "string",
      "minLength": 1
    },
    "ready": {
      "type": "boolean"
    },
    "customer_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "deployment_id": {
      "type": "string"
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "monitoring_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "register_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
