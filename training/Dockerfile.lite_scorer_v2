# Director-AI — Lite Scorer v2 Vertex container

FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY requirements/docker-build.txt requirements/docker-build.txt
COPY training/requirements-distil.txt training/requirements-distil.txt
RUN pip install --no-cache-dir --require-hashes \
      -r requirements/docker-build.txt -r training/requirements-distil.txt \
    && pip check
COPY pyproject.toml setup.py README.md ./
COPY packages/tier_build_hooks.py packages/paid_tier_manifest.json packages/
COPY src/ src/

COPY training/__init__.py training/__init__.py
COPY training/train_distillation.py training/train_distillation.py
COPY training/lite_scorer_v2_vertex_runner.py training/lite_scorer_v2_vertex_runner.py
RUN pip install --no-cache-dir --no-deps --no-build-isolation -e . && pip check
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/app \
    TOKENIZERS_PARALLELISM=false \
    DIRECTOR_REQUIRE_CUDA=1
ENTRYPOINT ["python", "-m", "training.lite_scorer_v2_vertex_runner"]
