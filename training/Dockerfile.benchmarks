# Director-AI — Vertex benchmark container

FROM rust:1.98.1-slim@sha256:4cd829461bd5c4d511c32e269da9cb8929223b666519d8004e35fc8d1d771ab7 AS rust-toolchain
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends \
      git build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_BUILD_JOBS=2

COPY requirements/docker-build.txt requirements/docker-build.txt
COPY training/requirements-distil.txt training/requirements-distil.txt
COPY training/requirements-benchmark-tools.txt training/requirements-benchmark-tools.txt
RUN pip install --no-cache-dir --require-hashes \
      -r requirements/docker-build.txt \
      -r training/requirements-distil.txt \
      -r training/requirements-benchmark-tools.txt \
    && pip check

COPY pyproject.toml setup.py README.md ./
COPY packages/tier_build_hooks.py packages/paid_tier_manifest.json packages/
COPY src/ src/
COPY backfire-kernel/ backfire-kernel/
COPY benchmarks/ benchmarks/
COPY training/ training/
COPY tests/ tests/
COPY formal/ formal/
COPY tools/ tools/
COPY schemas/ schemas/

RUN cd backfire-kernel/crates/backfire-ffi \
    && maturin build --locked --release --out /tmp/wheels \
    && pip install --no-cache-dir --no-deps /tmp/wheels/*.whl \
    && rm -rf /tmp/wheels
RUN pip install --no-cache-dir --no-deps --no-build-isolation -e . \
    && pip check \
    && mkdir -p /workspace/output

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/src:/workspace \
    DIRECTOR_RUN_ENV=vertex \
    DIRECTOR_REQUIRE_CUDA=1

ENTRYPOINT ["bash", "benchmarks/run_in_container.sh"]
