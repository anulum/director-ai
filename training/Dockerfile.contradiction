# Director-AI — Contradiction LoRA Vertex container

FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app
COPY training/requirements-contradiction.txt training/requirements-contradiction.txt
RUN pip install --no-cache-dir --require-hashes \
      -r training/requirements-contradiction.txt \
    && pip check
COPY training/ /app/training/
ENTRYPOINT ["python", "-m", "training.vertex_contradiction_entrypoint"]
