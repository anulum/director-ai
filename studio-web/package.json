{
    "name": "@anulum/director-ai-studio",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "Director-AI AI-Safety / Streaming Academy",
    "license": "Apache-2.0",
    "engines": {
        "node": "^22.23.4 || ^24.0.0 || >=26.0.0"
    },
    "scripts": {
        "sync:manifest": "node scripts/sync-manifest.mjs",
        "predev": "npm run sync:manifest",
        "prebuild": "npm run sync:manifest",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run src",
        "e2e": "playwright test",
        "lint": "eslint . && tsc --noEmit",
        "check:manifest": "node ../packages/vercel-ai/node_modules/typescript/bin/tsc --project tsconfig.manifest.json",
        "test:manifest": "npm run check:manifest && node --test --experimental-test-coverage --test-coverage-exclude=node_modules/** --test-coverage-include=src/contract/manifest.ts --test-coverage-include=test/manifest.node.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/manifest.node.mjs",
        "docs:manifest": "node ../packages/vercel-ai/node_modules/typedoc/bin/typedoc --entryPoints src/contract/manifest.ts --tsconfig tsconfig.manifest.json --readme README.md --out build/manifest-docs --name \"Director-AI Studio manifest\" --validation.notDocumented --validation.notExported --validation.invalidLink --treatWarningsAsErrors --treatValidationWarningsAsErrors"
    },
    "dependencies": {
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router-dom": "7.18.5",
        "backfire-wasm": "file:../backfire-kernel/crates/backfire-wasm/pkg"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@module-federation/runtime": "2.9.3",
        "@module-federation/vite": "1.24.1",
        "@playwright/test": "1.65.1",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript-eslint/parser": "8.73.0",
        "@vitejs/plugin-react": "6.3.0",
        "@vitest/coverage-v8": "5.1.0",
        "eslint": "10.15.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "typescript": "5.8.2",
        "vite": "8.3.8",
        "vitest": "5.1.0",
        "webpack": "5.112.2"
    }
}
