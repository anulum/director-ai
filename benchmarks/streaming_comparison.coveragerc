# Director-AI — complete streaming comparison Python coverage
[run]
branch = True
parallel = True
data_file = build/streaming-comparison/.coverage
include =
    benchmarks/wasm_overhead_bench.py
    tests/test_wasm_overhead_bench.py
    tests/test_wasm_ci_contracts.py
    tests/test_tools/test_ci_workflow_inventory.py

[report]
exclude_lines =
exclude_also =
partial_branches =
