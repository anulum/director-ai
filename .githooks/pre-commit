# BEGIN enterprise-trust local pre-commit exposure guard
set -eu

blocked_patterns='(^|/)(\.coordination|docs/internal|04_ARCANE_SAPIENCE|ARCHIVE|BACKUP|MODELS)(/|$)|(^|/)\.env($|\.)|(^|/)\.coverage($|\.)|(^|/)coverage\.xml$|(^|/).*\.(pem|key|log)$|(^|/)id_(rsa|ed25519)$|(^|/)(credentials?|secrets?|tokens?)(/|$|[._-])'
allowed_patterns='(^|/)discord-bot/\.env\.example$|(^|/)src/.*/secret_sharing\.py$|(^|/)benchmarks/models/.*/tokenizer(_config)?\.json$'
agent_identity_names='C[o]dex|OpenA[I]|ChatG[P]T|Cl[a]ude|G[e]mini|Anthr[o]pic'
agent_identity_patterns="(^|[^[:alnum:]_])(generated|written|created|implemented|authored|produced|made)[[:space:]]+(by|with|using)[[:space:]]+(${agent_identity_names})([^[:alnum:]_]|$)|(^|[^[:alnum:]_])(${agent_identity_names})[[:space:]]+(generated|wrote|created|implemented|authored|produced|made)([^[:alnum:]_]|$)"
google_api_prefix='AI''za'
oauth_prefix='ya''29\.'
generic_api_key_pattern='(^|[^0-9A-Za-z_-])s''k-[0-9A-Za-z_-]{20,}'
github_prefix='gh''p_'
ghpat_prefix='github''_pat_'
slack_prefix='xo''x[baprs]-'
polar_prefix='polar''_oat_'
private_key_pattern='BEGIN (RSA|OPENSSH|PRIV''ATE) KEY'
license_signing_var='DIRECTOR_LICENSE_SIGNING''_KEY'
admin_key_var='DIRECTOR_ADMIN''_KEY'
secret_patterns="${google_api_prefix}[0-9A-Za-z_-]{20,}|${oauth_prefix}[0-9A-Za-z_-]{20,}|${generic_api_key_pattern}|${github_prefix}[0-9A-Za-z_]{20,}|${ghpat_prefix}[0-9A-Za-z_]{20,}|${slack_prefix}[0-9A-Za-z-]{20,}|${polar_prefix}[0-9A-Za-z_]{20,}|${private_key_pattern}|${license_signing_var}=[^[:space:]]{8,}|${admin_key_var}=[^[:space:]]{8,}"

blocked=''
while IFS= read -r path; do
  if printf '%s\n' "$path" | grep -E "$blocked_patterns" >/dev/null; then
    if ! printf '%s\n' "$path" | grep -E "$allowed_patterns" >/dev/null; then
      blocked="${blocked}
${path}"
    fi
  fi
done <<EOF
$(git diff --cached --name-only)
EOF

if [ -n "$blocked" ]; then
  printf '%s\n' "ERROR: enterprise-trust blocked staged internal or sensitive paths:" >&2
  printf '%s\n' "$blocked" >&2
  printf '%s\n' "Move internal artefacts to ignored internal storage or get explicit remediation approval." >&2
  exit 1
fi

if ! python3 tools/verify_public_sector_boundary.py --root . --staged; then
  printf '%s\n' "ERROR: enterprise-trust blocked staged proprietary sector-pack boundary." >&2
  exit 1
fi

staged_additions="$(git diff --cached -U0 --no-ext-diff -- . \
  ':(exclude)docs/internal/**' \
  ':(exclude).coordination/**' \
  ':(exclude)04_ARCANE_SAPIENCE/**' \
  | grep -E '^\+[^+]' || true)"

if printf '%s\n' "$staged_additions" | grep -Ei "$agent_identity_patterns" >/dev/null; then
  printf '%s\n' "ERROR: enterprise-trust blocked staged public implementation-agent identity text." >&2
  printf '%s\n' "Use Arcane Sapience in public tracked files and keep implementation attribution internal." >&2
  exit 1
fi

if printf '%s\n' "$staged_additions" | grep -E "$secret_patterns" >/dev/null; then
  printf '%s\n' "ERROR: enterprise-trust blocked staged credential-like content." >&2
  printf '%s\n' "Keep credential values in the shared credential vault or runtime secret stores only." >&2
  exit 1
fi
# END enterprise-trust local pre-commit exposure guard
