# Director-Class AI - Local commit message attribution guard

set -eu

message_file="${1:?commit message file required}"
required_authorship_line='Authored by Anulum Fortis & Arcane Sapience (protoscience@anulum.li)'
agent_identity_names='C[o]dex|OpenA[I]|ChatG[P]T|Cl[a]ude|G[e]mini|Anthr[o]pic'
agent_identity_patterns="(^|[^[:alnum:]_])(generated|written|created|implemented|authored|produced|made)[[:space:]]+(by|with|using)[[:space:]]+(${agent_identity_names})([^[:alnum:]_]|$)|(^|[^[:alnum:]_])(${agent_identity_names})[[:space:]]+(generated|wrote|created|implemented|authored|produced|made)([^[:alnum:]_]|$)"

if [ ! -f "$message_file" ]; then
  printf '%s\n' "ERROR: commit message file is missing." >&2
  exit 1
fi

required_count="$(grep -F -x -c "$required_authorship_line" "$message_file" || true)"
if [ "$required_count" -ne 1 ]; then
  printf '%s\n' "ERROR: commit message must contain exactly one required authorship line:" >&2
  printf '%s\n' "$required_authorship_line" >&2
  exit 1
fi

legacy_coauthored_count="$(grep -E -c '^Co-Authored-By:' "$message_file" || true)"
if [ "$legacy_coauthored_count" -ne 0 ]; then
  printf '%s\n' "ERROR: commit message must not use legacy Co-Authored-By trailers." >&2
  exit 1
fi

if grep -Ei "$agent_identity_patterns" "$message_file" >/dev/null; then
  printf '%s\n' "ERROR: commit message contains blocked implementation-agent identity text." >&2
  exit 1
fi
